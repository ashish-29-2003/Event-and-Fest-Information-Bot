# ============================================================
# .env.example – Template for environment variables
# ============================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env   (or duplicate in File Explorer)
#   2. Open .env and replace "your_gemini_api_key_here" with your real key
#   3. NEVER commit .env to GitHub! It is already in .gitignore.
#
# HOW TO GET YOUR GEMINI API KEY:
#   1. Go to https://aistudio.google.com/
#   2. Sign in with your Google account
#   3. Click "Get API key" → "Create API key"
#   4. Copy the generated key and paste it below (in your .env, not here!)
#
# FREE TIER LIMITS (as of 2025):
#   • gemini-1.5-flash: 15 requests/minute, 1 million tokens/day
#   • More than enough for a college project demo!
# ============================================================

GEMINI_API_KEY=your_gemini_api_key_here
