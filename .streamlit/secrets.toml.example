# ============================================================
# .streamlit/secrets.toml.example – Streamlit Secrets Template
# ============================================================
# HOW TO USE:
#   1. Copy this file to .streamlit/secrets.toml
#      (create .streamlit/ folder if it doesn't exist)
#   2. Replace "your_gemini_api_key_here" with your real key
#   3. NEVER commit secrets.toml to GitHub!
#      It is already listed in .gitignore.
#
# In your Python code, read the key with:
#   import streamlit as st
#   api_key = st.secrets["GEMINI_API_KEY"]
#
# This file (secrets.toml.example) is SAFE to commit —
# it contains only placeholder text, not a real key.
# ============================================================

GEMINI_API_KEY = "your_gemini_api_key_here"
